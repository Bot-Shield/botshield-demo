{
  "name": "botshield-demo",
  "vars": {
    // The Ticketz demo gateway (Fly). Flip to https://gateway-demo.botshield.ai once its DNS lands.
    "AGENT_GATEWAY_URL": "https://botshield-demo-gateway.fly.dev",
    // The Meridian Airlines demo gateway (Fly) — the FIDO payment-guardrail demo (/flights).
    "MERIDIAN_GATEWAY_URL": "https://botshield-meridian-gateway.fly.dev",
    "AGENT_MODEL": "claude-opus-5"
  },
  // Demo usage — cookieless counts (src/analytics.ts), read by /stats through the SQL API.
  "analytics_engine_datasets": [
    { "binding": "DEMO_EVENTS", "dataset": "botshield_demo_events" }
  ],
  "main": "src/worker.ts",
  "compatibility_date": "2024-12-30",
  "account_id": "9e8a7774180038be08d52d95adbc82c5",
  "routes": [
    {
      "pattern": "demo.botshield.ai",
      "custom_domain": true
    }
  ],
  // Staging worker — `npm run deploy:staging`. Same code; the pages see the
  // demo-staging host and load cdn-staging (→ wg-staging) + staging site keys
  // (src/backend.ts). Vars and bindings are NOT inherited by an env, so they
  // are repeated here. Agents Ask (/agent) and Meridian (/flights) still talk
  // to the production Fly gateways. Secrets (ANTHROPIC_API_KEY, STATS_KEY,
  // CF_ACCOUNT_ID, CF_ANALYTICS_TOKEN) must be set with --env staging.
  "env": {
    "staging": {
      "name": "botshield-demo-staging",
      "vars": {
        "AGENT_GATEWAY_URL": "https://botshield-demo-gateway.fly.dev",
        "MERIDIAN_GATEWAY_URL": "https://botshield-meridian-gateway.fly.dev",
        "AGENT_MODEL": "claude-opus-5",
        "DEMO_DATASET": "botshield_demo_events_staging"
      },
      "analytics_engine_datasets": [
        { "binding": "DEMO_EVENTS", "dataset": "botshield_demo_events_staging" }
      ],
      "routes": [
        {
          "pattern": "demo-staging.botshield.ai",
          "custom_domain": true
        }
      ]
    }
  }
}
